CompileFlags:
    Add: [
    	-std=c++20, -fno-exceptions, -Wdeprecated, -Wall, -Wextra, -Wpedantic, -Wconversion,
        -Wimplicit-fallthrough, -Wmissing-prototypes, -Wmissing-variable-declarations, -Wpadded,
        -Wredundant-parens, -Wswitch-default, -Wunaligned-access, -Wunreachable-code-aggressive
    ]
---
If:
    PathMatch: .*\.cpp
CompileFlags:
    Add: [-xc++]
---
If:
    PathMatch: .*\.hpp
CompileFlags:
    Add: [-xc++-header]
