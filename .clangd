CompileFlags:
    Add: [
        -xc++, -std=c++20, -fno-exceptions, -Wdeprecated, -Wall, -Wextra, -Wpedantic,
        -Wconversion, -Wimplicit-fallthrough, -Wmissing-prototypes,
        -Wmissing-variable-declarations, -Wswitch-default, -Wunreachable-code-aggressive,
        -Wno-empty-translation-unit, -Wno-unused-parameter
    ]
